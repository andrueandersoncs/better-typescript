{
  "name": "@better-typescript/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./linter": {
      "bun": "./src/linter/linter.ts",
      "default": "./dist/linter/linter.js"
    },
    "./project/loadProject": {
      "bun": "./src/project/loadProject/loadProject.ts",
      "default": "./dist/project/loadProject/loadProject.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b tsconfig.json --force",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "effect": "^4.0.0-beta.98"
  },
  "peerDependencies": {
    "typescript": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
