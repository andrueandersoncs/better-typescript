{
  "name": "@better-typescript/core",
  "version": "0.0.2",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./analysis": {
      "bun": "./src/analysis/runAnalysis.ts",
      "default": "./dist/analysis/runAnalysis.js"
    },
    "./config": {
      "bun": "./src/config/config.ts",
      "default": "./dist/config/config.js"
    },
    "./config/loadConfig": {
      "bun": "./src/config/loadConfig.ts",
      "default": "./dist/config/loadConfig.js"
    },
    "./linter": {
      "bun": "./src/linter/linter.ts",
      "default": "./dist/linter/linter.js"
    },
    "./ruleName": {
      "bun": "./src/linter/ruleName.ts",
      "default": "./dist/linter/ruleName.js"
    },
    "./project/loadProject": {
      "bun": "./src/project/loadProject/loadProject.ts",
      "default": "./dist/project/loadProject/loadProject.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b tsconfig.json --force",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --timeout 30000 test/*.test.ts"
  },
  "dependencies": {},
  "peerDependencies": {
    "typescript": "^5.0.0 || ^6.0.0",
    "effect": "4.0.0-beta.98"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3",
    "effect": "4.0.0-beta.98"
  },
  "publishConfig": {
    "access": "public"
  }
}
