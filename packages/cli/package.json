{
  "name": "@better-typescript/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "better-typescript": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun src/index.ts --pretty",
    "start": "bun src/index.ts",
    "build": "rm -rf dist && tsc -b tsconfig.json --force && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@better-typescript/core": "0.0.0",
    "@effect/platform-bun": "^4.0.0-beta.98",
    "effect": "^4.0.0-beta.98",
    "@better-typescript/rules": "0.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
