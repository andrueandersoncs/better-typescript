{
  "name": "@better-typescript/matchers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./matcher": {
      "bun": "./src/matcher/matcher.ts",
      "default": "./dist/matcher/matcher.js"
    },
    "./matcher/data": {
      "bun": "./src/matcher/data.ts",
      "default": "./dist/matcher/data.js"
    },
    "./sources": {
      "bun": "./src/sources/sources.ts",
      "default": "./dist/sources/sources.js"
    },
    "./sources/data": {
      "bun": "./src/sources/data.ts",
      "default": "./dist/sources/data.js"
    },
    "./sources/comments": {
      "bun": "./src/sources/comments.ts",
      "default": "./dist/sources/comments.js"
    },
    "./sources/comments/data": {
      "bun": "./src/sources/commentsData.ts",
      "default": "./dist/sources/commentsData.js"
    },
    "./equivalence": {
      "bun": "./src/equivalence.ts",
      "default": "./dist/equivalence.js"
    },
    "./tsSchema": {
      "bun": "./src/tsSchema.ts",
      "default": "./dist/tsSchema.js"
    },
    "./*": {
      "bun": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json",
    "./support/*": {
      "bun": "./src/support/*.ts",
      "default": "./dist/support/*.js"
    },
    "./support/*.js": {
      "bun": "./src/support/*.ts",
      "default": "./dist/support/*.js"
    },
    "./builtins/*": {
      "bun": "./src/builtins/*.ts",
      "default": "./dist/builtins/*.js"
    },
    "./builtins/*.js": {
      "bun": "./src/builtins/*.ts",
      "default": "./dist/builtins/*.js"
    },
    "./builtins/*/*.js": {
      "bun": "./src/builtins/*/*.ts",
      "default": "./dist/builtins/*/*.js"
    },
    "./builtins/*/data": {
      "bun": "./src/builtins/*/data.ts",
      "default": "./dist/builtins/*/data.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "effect": "^4.0.0-beta.98"
  },
  "peerDependencies": {
    "typescript": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
