{
  "name": "@better-typescript/matchers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "compat"
  ],
  "exports": {
    "./builtins/effectQuality/effectQualityFeature": {
      "types": "./compat/effectQualityFeature.d.ts",
      "bun": "./compat/effectQualityFeature.js",
      "default": "./compat/effectQualityFeature.js"
    },
    "./builtins/effectQuality/effectQualityFeature.js": {
      "types": "./compat/effectQualityFeature.d.ts",
      "bun": "./compat/effectQualityFeature.js",
      "default": "./compat/effectQualityFeature.js"
    },
    "./builtins/functionalCoreEffect/functionalCoreEffectFeatures": {
      "types": "./compat/functionalCoreEffectFeatures.d.ts",
      "bun": "./compat/functionalCoreEffectFeatures.js",
      "default": "./compat/functionalCoreEffectFeatures.js"
    },
    "./builtins/functionalCoreEffect/functionalCoreEffectFeatures.js": {
      "types": "./compat/functionalCoreEffectFeatures.d.ts",
      "bun": "./compat/functionalCoreEffectFeatures.js",
      "default": "./compat/functionalCoreEffectFeatures.js"
    },
    "./equivalence": {
      "bun": "./src/equivalence.ts",
      "default": "./dist/equivalence.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "bun": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "./matcher/*": {
      "bun": "./src/matcher/*.ts",
      "default": "./dist/matcher/*.js"
    },
    "./matcher/*.js": {
      "bun": "./src/matcher/*.ts",
      "default": "./dist/matcher/*.js"
    },
    "./sources/*": {
      "bun": "./src/sources/*.ts",
      "default": "./dist/sources/*.js"
    },
    "./sources/*.js": {
      "bun": "./src/sources/*.ts",
      "default": "./dist/sources/*.js"
    },
    "./sources/data": {
      "bun": "./src/sources/data.ts",
      "default": "./dist/sources/data.js"
    },
    "./sources/comments/data": {
      "bun": "./src/sources/commentsData.ts",
      "default": "./dist/sources/commentsData.js"
    },
    "./support/*": {
      "bun": "./src/support/*.ts",
      "default": "./dist/support/*.js"
    },
    "./support/*.js": {
      "bun": "./src/support/*.ts",
      "default": "./dist/support/*.js"
    },
    "./builtins/*": {
      "bun": "./src/builtins/*.ts",
      "default": "./dist/builtins/*.js"
    },
    "./builtins/*.js": {
      "bun": "./src/builtins/*.ts",
      "default": "./dist/builtins/*.js"
    },
    "./builtins/*/*.js": {
      "bun": "./src/builtins/*/*.ts",
      "default": "./dist/builtins/*/*.js"
    },
    "./builtins/*/data": {
      "bun": "./src/builtins/*/data.ts",
      "default": "./dist/builtins/*/data.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "effect": "^4.0.0-beta.98"
  },
  "peerDependencies": {
    "typescript": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
