{
  "name": "@better-typescript/rules",
  "version": "0.0.3",
  "type": "module",
  "files": [
    "dist",
    "src",
    "!src/rules/*/fixtures",
    "!src/rules/*/test"
  ],
  "exports": {
    "./builtinRules": {
      "bun": "./src/builtinRules.ts",
      "default": "./dist/builtinRules.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b tsconfig.json --force",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --timeout 30000 test/*.test.ts src/rules/*/test/*.test.ts"
  },
  "dependencies": {
    "@better-typescript/core": "0.0.3"
  },
  "peerDependencies": {
    "typescript": "^5.0.0 || ^6.0.0",
    "effect": "4.0.0-beta.98"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3",
    "effect": "4.0.0-beta.98"
  },
  "publishConfig": {
    "access": "public"
  }
}
