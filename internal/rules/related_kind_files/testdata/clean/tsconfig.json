{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "effect": [
        "./packages/effect/src/index.d.ts"
      ],
      "external-chain": [
        "./packages/external-chain/index.d.ts"
      ],
      "outside-source": [
        "../outside-dependency/wrong.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
