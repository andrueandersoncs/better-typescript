{
  "overrides": [
    {
      "type": "inclusion",
      "files": "src/**/*.ts",
      "rules": ["no-error-type", "no-throw"]
    },
    {
      "type": "exclusion",
      "files": "src/nested/**/*.ts",
      "rules": "no-throw"
    },
    {
      "type": "exclusion",
      "files": "src/nested/disabled.ts",
      "rules": ["no-error-type"]
    }
  ]
}
