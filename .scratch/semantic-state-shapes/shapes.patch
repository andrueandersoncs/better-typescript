--- /dev/null
+++ b/internal/semanticlint/shape_probe_test.go
@@ -0,0 +1,81 @@
+package semanticlint
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// Throwaway: prints sample requests and candidate-stage bytes per shape.
+func TestShapeProbe(t *testing.T) {
+	if os.Getenv("SHAPE_PROBE") == "" {
+		t.Skip()
+	}
+	rules, err := loadRules(t.TempDir(), "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cases, err := loadEvalCorpus(evalDirectory, rules)
+	if err != nil {
+		t.Fatal(err)
+	}
+	policies := policyIndex(rules)
+	shapes := map[string]stateShape{"base": {}, "policy": {Policy: true}, "whole": {Whole: true}, "lines": {Lines: true}}
+	workload, err := os.ReadFile(filepath.Join(evalDirectory, "workload.txt"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, name := range []string{"base", "policy", "whole", "lines"} {
+		settings := Options{shape: shapes[name]}.requestSettings()
+		valBytes, valRequests := 0, 0
+		for _, item := range cases {
+			if item.Split != "val" {
+				continue
+			}
+			source, _, err := caseSource(evalDirectory, item)
+			if err != nil {
+				t.Fatal(err)
+			}
+			partitions, err := buildRequestPartitions(source, []Rule{policies[item.Policy]}, settings, maximumRequestBytes)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, partition := range partitions {
+				valBytes += requestSize(partition.request)
+				valRequests++
+			}
+		}
+		packedBytes, packedRequests := 0, 0
+		for _, path := range strings.Fields(string(workload)) {
+			content, err := os.ReadFile(filepath.Join("..", "..", filepath.FromSlash(path)))
+			if err != nil {
+				t.Fatal(err)
+			}
+			partitions, err := buildRequestPartitions(Source{Path: path, Text: string(content)}, rulesForPath(rules, nil, path), settings, maximumRequestBytes)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, partition := range partitions {
+				packedBytes += requestSize(partition.request)
+				packedRequests++
+			}
+		}
+		fmt.Printf("%-7s val candidate %9d bytes %5d requests | workload packed candidate %9d bytes %5d requests\n", name, valBytes, valRequests, packedBytes, packedRequests)
+	}
+	source := Source{Path: "src/a.ts", Text: "const a = 1\nconst b = 2\nconst c = 3\n"}
+	rule := Rule{ID: "rule_1", Source: "POLICY TEXT"}
+	for _, name := range []string{"policy", "lines"} {
+		settings := Options{shape: shapes[name]}.requestSettings()
+		windows := []sourceWindow{{0, 12}, {24, len(source.Text)}}
+		for _, request := range []evaluationRequest{
+			candidateRequest(source, sourceWindow{0, len(source.Text)}, []Rule{rule}, settings),
+			evidenceRequest(source, rule, windows, settings),
+			finalRequest(source, rule, windows, candidateRanges(source, windows), settings),
+		} {
+			encoded, _ := marshalJSON(request)
+			fmt.Printf("%s: %s\n", name, encoded)
+		}
+	}
+}
