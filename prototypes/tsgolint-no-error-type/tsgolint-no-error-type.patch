diff --git a/cmd/tsgolint/no_error_type_bench_test.go b/cmd/tsgolint/no_error_type_bench_test.go
new file mode 100644
index 0000000..5bc6770
--- /dev/null
+++ b/cmd/tsgolint/no_error_type_bench_test.go
@@ -0,0 +1,138 @@
+package main
+
+import (
+	"runtime"
+	"sync/atomic"
+	"testing"
+
+	"github.com/microsoft/typescript-go/shim/ast"
+	"github.com/typescript-eslint/tsgolint/internal/diagnostic"
+	"github.com/typescript-eslint/tsgolint/internal/linter"
+	"github.com/typescript-eslint/tsgolint/internal/rule"
+	"github.com/typescript-eslint/tsgolint/internal/rules/no_error_type"
+	"github.com/typescript-eslint/tsgolint/internal/utils"
+)
+
+var typeReferenceTraversalRule = rule.Rule{
+	Name: "benchmark-type-reference-traversal",
+	Run: func(ctx rule.RuleContext, options any) rule.RuleListeners {
+		return rule.RuleListeners{
+			ast.KindTypeReference: func(node *ast.Node) {},
+		}
+	},
+}
+
+func countTypeReferences(files []*ast.SourceFile) int64 {
+	var count int64
+	var visitor ast.Visitor
+	visitor = func(node *ast.Node) bool {
+		if node.Kind == ast.KindTypeReference {
+			count++
+		}
+		node.ForEachChild(visitor)
+		return false
+	}
+
+	for _, file := range files {
+		file.Node.ForEachChild(visitor)
+	}
+
+	return count
+}
+
+func configuredBenchmarkRule(benchmarkRule *rule.Rule) func(*ast.SourceFile) []linter.ConfiguredRule {
+	return func(_ *ast.SourceFile) []linter.ConfiguredRule {
+		return []linter.ConfiguredRule{{
+			Name: benchmarkRule.Name,
+			Run: func(ctx rule.RuleContext) rule.RuleListeners {
+				return benchmarkRule.Run(ctx, nil)
+			},
+		}}
+	}
+}
+
+func runConfiguredRuleBenchmark(
+	b *testing.B,
+	env benchmarkEnv,
+	benchmarkRule *rule.Rule,
+) int64 {
+	b.Helper()
+
+	var diagnosticCount atomic.Int64
+	err := linter.RunLinterOnProgram(linter.RunLinterOnProgramOptions{
+		LogLevel:             utils.LogLevelNormal,
+		Program:              env.program,
+		Files:                env.files,
+		Workers:              runtime.GOMAXPROCS(0),
+		GetRulesForFile:      configuredBenchmarkRule(benchmarkRule),
+		OnDiagnostic:         func(_ rule.RuleDiagnostic) { diagnosticCount.Add(1) },
+		OnInternalDiagnostic: func(_ diagnostic.Internal) {},
+	})
+	if err != nil {
+		b.Fatal("linter failed:", err)
+	}
+
+	return diagnosticCount.Load()
+}
+
+func runWarmProgramBenchmark(b *testing.B, benchmarkRule *rule.Rule, expectDiagnostics bool) {
+	b.Helper()
+	b.ReportAllocs()
+
+	env := setupBenchmarkEnv(b, false)
+	diagnosticCount := runConfiguredRuleBenchmark(b, env, benchmarkRule)
+	if expectDiagnostics && diagnosticCount == 0 {
+		b.Fatal("no diagnostics were emitted")
+	}
+	b.ResetTimer()
+	for b.Loop() {
+		runConfiguredRuleBenchmark(b, env, benchmarkRule)
+	}
+
+	b.ReportMetric(float64(len(env.files)), "files/op")
+	b.ReportMetric(float64(countTypeReferences(env.files)), "type-references/op")
+	b.ReportMetric(float64(diagnosticCount), "diagnostics/op")
+}
+
+func runColdProgramBenchmark(b *testing.B, benchmarkRule *rule.Rule, expectDiagnostics bool) {
+	b.Helper()
+	b.ReportAllocs()
+
+	env := setupBenchmarkEnv(b, false)
+	diagnosticCount := runConfiguredRuleBenchmark(b, env, benchmarkRule)
+	if expectDiagnostics && diagnosticCount == 0 {
+		b.Fatal("no diagnostics were emitted")
+	}
+	b.ResetTimer()
+	for b.Loop() {
+		runConfiguredRuleBenchmark(b, setupBenchmarkEnv(b, false), benchmarkRule)
+	}
+
+	b.ReportMetric(float64(len(env.files)), "files/op")
+	b.ReportMetric(float64(countTypeReferences(env.files)), "type-references/op")
+	b.ReportMetric(float64(diagnosticCount), "diagnostics/op")
+}
+
+// BenchmarkTypeReferenceTraversalWarmProgram is the warm baseline. It performs
+// the same AST traversal and TypeReference listener dispatch without checker work.
+func BenchmarkTypeReferenceTraversalWarmProgram(b *testing.B) {
+	runWarmProgramBenchmark(b, &typeReferenceTraversalRule, false)
+}
+
+// BenchmarkNoErrorTypeWarmProgram measures the port after program creation and
+// checker warmup. Subtract the traversal baseline to estimate incremental cost.
+func BenchmarkNoErrorTypeWarmProgram(b *testing.B) {
+	runWarmProgramBenchmark(b, &no_error_type.NoErrorTypeRule, true)
+}
+
+// BenchmarkTypeReferenceTraversalColdProgram is the cold baseline. It creates a
+// fresh TypeScript program for every operation, with a potentially warm OS cache.
+func BenchmarkTypeReferenceTraversalColdProgram(b *testing.B) {
+	runColdProgramBenchmark(b, &typeReferenceTraversalRule, false)
+}
+
+// BenchmarkNoErrorTypeColdProgram includes fresh TypeScript program creation for
+// every operation. The OS file cache may still be warm between operations.
+func BenchmarkNoErrorTypeColdProgram(b *testing.B) {
+	runColdProgramBenchmark(b, &no_error_type.NoErrorTypeRule, true)
+}
