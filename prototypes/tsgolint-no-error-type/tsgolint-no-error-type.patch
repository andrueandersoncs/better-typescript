@@ -0,0 +1,54 @@
+package no_error_type
+
+import (
+	"testing"
+
+	"github.com/typescript-eslint/tsgolint/internal/rule_tester"
+	"github.com/typescript-eslint/tsgolint/internal/rules/fixtures"
+)
+
+func TestNoErrorTypeRule(t *testing.T) {
+	t.Parallel()
+
+	rule_tester.RunRuleTester(
+		fixtures.GetRootDir(),
+		"tsconfig.minimal.json",
+		t,
+		&NoErrorTypeRule,
+		[]rule_tester.ValidTestCase{
+			{Code: `class ParseError extends Error {}`},
+			{Code: `const builtInErrorValue = new Error("runtime value");`},
+			{Code: `const builtInErrorConstructor: ErrorConstructor = Error;`},
+			{Code: `export {}; type Error = { readonly message: string }; const localFailure: Error = { message: "local" };`},
+			{Code: `namespace Local { export type Error = { readonly message: string } }; type LocalFailure = Local.Error;`},
+			{Code: `type UnknownFailure = unknown;`},
+			{Code: `type GenericFailure<E> = E;`},
+		},
+		[]rule_tester.InvalidTestCase{
+			{
+				Code:   `const messageOf = (error: Error): string => error.message;`,
+				Errors: []rule_tester.InvalidTestCaseError{{MessageId: "noErrorType"}},
+			},
+			{
+				Code:   `type Failure = Error | { readonly code: string };`,
+				Errors: []rule_tester.InvalidTestCaseError{{MessageId: "noErrorType"}},
+			},
+			{
+				Code:   `type QualifiedFailure = globalThis.Error;`,
+				Errors: []rule_tester.InvalidTestCaseError{{MessageId: "noErrorType"}},
+			},
+			{
+				Code:   `interface ErrorSink { readonly push: (error: Error) => void }`,
+				Errors: []rule_tester.InvalidTestCaseError{{MessageId: "noErrorType"}},
+			},
+			{
+				Code: `type Many = [Error, Promise<Error>, globalThis.Error];`,
+				Errors: []rule_tester.InvalidTestCaseError{
+					{MessageId: "noErrorType"},
+					{MessageId: "noErrorType"},
+					{MessageId: "noErrorType"},
+				},
+			},
+		},
+	)
+}
